<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />


    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProCalorieAI"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Onboarding1Activity"
            android:exported="false" />

        <activity
            android:name=".Onboarding2Activity"
            android:exported="false" />

        <activity
            android:name=".Onboarding3Activity"
            android:exported="false" />

        <activity
            android:name=".Onboarding4Activity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="true"/>

        <activity
            android:name=".HistoryActivity"
            android:exported="true"/>

        <activity
            android:name=".ScanActivity"
            android:exported="true"/>

        <!-- FileProvider для камеры -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".GoalsActivity"
            android:exported="true"/>

        <activity
            android:name=".GeneralSettingsActivity"
            android:exported="true"/>
        <activity
            android:name=".PreferencesActivity"
            android:exported="true"/>

        <activity
            android:name=".AssistantActivity"
            android:exported="true"/>

        <activity
            android:name=".PrivacyActivity"
            android:exported="true"/>



    </application>
</manifest>